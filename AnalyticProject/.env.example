# PostgreSQL — required from F0-02 (Prisma)
DATABASE_URL="postgresql://analyticsaas:analyticsaas@localhost:5432/analyticsaas"

# Auth.js (F1-01+) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Inngest (F0-03+) — required for local dev
INNGEST_DEV=1

# Inngest Cloud (production only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Source adapters (F3-02) — mock|live (default mock)
ADAPTER_MODE=mock

# Product Hunt GraphQL (live only)
PRODUCTHUNT_API_TOKEN=

# Reddit OAuth app (live only) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="AnalyticSaaS/0.1 by your_reddit_username"

# LLM client (F5-02+) — server-only; never import src/lib/llm in client components
# mock (default) | openrouter (рекомендуется из РФ) | openai | anthropic (не реализован)
LLM_PROVIDER=mock
LLM_API_KEY=
# OpenRouter model slug (when LLM_PROVIDER=openrouter):
# LLM_MODEL=openai/gpt-4o-mini
# Direct OpenAI:
# LLM_MODEL=gpt-4o-mini
LLM_MODEL=openai/gpt-4o-mini
# Optional override (openrouter default: https://openrouter.ai/api/v1)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution:
# LLM_HTTP_REFERER=http://localhost:3010
# LLM_APP_TITLE=AnalyticSaaS
# Optional: default mock fixture basename under fixtures/llm/
# LLM_FIXTURE=extract-pains

# E2E (F8-01) — optional fixed credentials; otherwise flow-a generates a unique email
# E2E_USER_EMAIL=e2e@test.local
# E2E_USER_PASSWORD=e2e-password-123
# E2E_BASE_URL=http://localhost:3010
