# PostgreSQL — required from F0-02 (Prisma)
DATABASE_URL="postgresql://analyticsaas:analyticsaas@localhost:5432/analyticsaas"

# Auth.js (F1-01+) — generate with: openssl rand -base64 32
AUTH_SECRET=

# Inngest (F0-03+) — required for local dev
INNGEST_DEV=1

# Inngest Cloud (production only)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Source adapters (F3-02) — mock|live (default mock)
ADAPTER_MODE=mock

# Product Hunt GraphQL (live only)
PRODUCTHUNT_API_TOKEN=

# Reddit OAuth app (live only) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="AnalyticSaaS/0.1 by your_reddit_username"
